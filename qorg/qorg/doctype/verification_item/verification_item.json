    {
      "fieldname": "valuation_rate",
      "label": "Valuation Rate",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "variance_value",
      "label": "Variance Value",
      "fieldtype": "Currency",
      "read_only": 1
    },
    {
      "fieldname": "variance_type",
      "label": "Variance Type",
      "fieldtype": "Select",
      "options": "\nSurplus\nShortage\nDamaged\nMissing\nWrong Location\nWrong Custodian\nUnregistered Asset\nSerial or Batch Mismatch",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "resolution_column",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "incident",
