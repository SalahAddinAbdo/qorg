    "item_code",
    "asset",
    "book_section",
    "book_warehouse",
    "book_location",
    "book_custodian",
    "book_qty",
    "actual_column",
    "actual_warehouse",
    "actual_location",
    "actual_custodian",
    "counted_qty",
    "variance_section",
    "variance_qty",
