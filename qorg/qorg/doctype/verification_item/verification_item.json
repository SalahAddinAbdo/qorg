    },
    {
      "fieldname": "actual_warehouse",
      "label": "Actual Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse"
    },
    {
      "fieldname": "actual_location",
      "label": "Actual Location",
      "fieldtype": "Link",
      "options": "Location"
    },
    {
      "fieldname": "actual_custodian",
      "label": "Actual Custodian",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "counted_qty",
      "label": "Counted Quantity",
      "fieldtype": "Float",
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "variance_section",
      "label": "Variance and Resolution",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "variance_qty",
      "label": "Variance Quantity",
      "fieldtype": "Float",
      "read_only": 1,
      "in_list_view": 1,
      "columns": 1
