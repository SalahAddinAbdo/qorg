    {
      "fieldname": "notes",
      "label": "Notes",
      "fieldtype": "Small Text"
    },
    {
      "fieldname": "page_break",
      "label": "Page Break After This Row",
      "fieldtype": "Check",
      "default": "0",
      "allow_on_submit": 1,
      "print_hide": 1
    }
  ]
