    {
      "fieldname": "asset",
      "label": "Asset",
      "fieldtype": "Link",
      "options": "Asset",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "book_section",
      "label": "Book Position",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "book_warehouse",
      "label": "Book Warehouse",
      "fieldtype": "Link",
      "options": "Warehouse"
    },
    {
      "fieldname": "book_location",
      "label": "Book Location",
      "fieldtype": "Link",
      "options": "Location"
    },
    {
      "fieldname": "book_custodian",
      "label": "Book Custodian",
      "fieldtype": "Link",
      "options": "Employee"
    },
    {
      "fieldname": "book_qty",
