      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "source_type",
      "label": "Source Type",
      "fieldtype": "Select",
      "options": "Internal Audit\nExternal Audit\nDonor Review\nCompliance Review\nQuality Assurance\nMonitoring Visit\nInvestigation\nManagement Review\nOther",
