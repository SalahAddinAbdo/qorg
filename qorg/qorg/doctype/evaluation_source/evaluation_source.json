{
  "doctype": "DocType",
  "name": "Evaluation Source",
  "module": "QOrg",
  "custom": 0,
  "track_changes": 1,
  "istable": 1,
  "editable_grid": 1,
  "field_order": [
    "source_section",
    "source",
    "include_score",
    "weight",
    "score_column",
    "score_type",
    "score_max",
    "pass_score",
    "review_section",
    "assignment_required",
    "required_reviewers",
    "min_reviews",
    "review_column",
    "assignment_strategy",
    "anonymous",
    "min_anonymous_group",
    "rules_section",
    "missing_policy",
    "criteria_set",
    "rules_column",
    "comments_below",
    "evidence_below"
  ],
  "fields": [
    {
      "fieldname": "source_section",
      "label": "Source and Score",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "source",
      "label": "Source",
      "fieldtype": "Select",
      "options": "Goals\nSelf\nDirect Manager\nPeers\nHuman Resources\nSenior Management\nRelated Department\nDirect Reports\nTechnical Assessor\nOther",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 3
    },
    {
      "fieldname": "include_score",
      "label": "Include in Final Score",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "weight",
      "label": "Weight (%)",
      "fieldtype": "Percent",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "score_column",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "score_type",
      "label": "Score Input Type",
      "fieldtype": "Select",
      "options": "Percentage\nNumeric Scale\nPass/Fail",
      "default": "Numeric Scale",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "score_max",
      "label": "Score Maximum",
      "fieldtype": "Float",
      "depends_on": "eval:doc.score_type=='Numeric Scale'"
    },
    {
      "fieldname": "pass_score",
      "label": "Pass Score",
      "fieldtype": "Float",
      "depends_on": "eval:doc.score_type=='Pass/Fail'"
    },
    {
      "fieldname": "review_section",
      "label": "Review Requirements",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "assignment_required",
      "label": "Reviewer Assignment Required",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "required_reviewers",
      "label": "Required Reviewers",
      "fieldtype": "Int",
      "default": "1",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "min_reviews",
      "label": "Minimum Completed",
      "fieldtype": "Int",
      "default": "1",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "review_column",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "assignment_strategy",
      "label": "Assignment Strategy",
      "fieldtype": "Select",
      "options": "Manual\nDirect Supervisor\nDepartment Head\nNamed HR Reviewers\nDirect Reports\nNamed Technical Assessors",
      "default": "Manual",
      "reqd": 1,
      "depends_on": "eval:doc.assignment_required"
    },
    {
      "fieldname": "anonymous",
      "label": "Anonymous",
      "fieldtype": "Check",
      "default": "0",
      "depends_on": "eval:doc.assignment_required"
    },
    {
      "fieldname": "min_anonymous_group",
      "label": "Minimum Anonymous Group",
      "fieldtype": "Int",
      "default": "3",
      "depends_on": "eval:doc.anonymous"
    },
    {
      "fieldname": "rules_section",
      "label": "Rules and Evidence",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "missing_policy",
      "label": "Missing Source Policy",
      "fieldtype": "Select",
      "options": "Use Evaluation Policy\nStrict Completion\nCompleted Weight\nReallocate Weight",
      "default": "Use Evaluation Policy"
    },
    {
      "fieldname": "criteria_set",
      "label": "Criteria Set",
      "fieldtype": "Link",
      "options": "Appraisal Template",
      "depends_on": "eval:doc.assignment_required"
    },
    {
      "fieldname": "rules_column",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "comments_below",
      "label": "Comments Required Below (%)",
      "fieldtype": "Percent"
    },
    {
      "fieldname": "evidence_below",
      "label": "Evidence Required Below (%)",
      "fieldtype": "Percent"
    }
  ],
  "permissions": []
}
