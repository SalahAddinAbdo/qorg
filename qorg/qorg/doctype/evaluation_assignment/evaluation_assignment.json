    "naming_series",
    "appraisal_cycle",
    "appraisal",
    "evaluation_type",
    "status",
    "overview_column",
    "assigned_on",
    "due_date",
    "submitted_on",
    "locked",
    "people_section",
    "employee",
    "employee_name",
    "evaluation_source",
    "weight",
    "anonymous",
    "people_column",
    "reviewer",
    "reviewer_name",
    "reviewer_user",
    "reviewer_category",
    "related_department",
