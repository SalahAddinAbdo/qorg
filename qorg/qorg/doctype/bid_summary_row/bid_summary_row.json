{
  "doctype": "DocType",
  "name": "Bid Summary Row",
  "module": "QOrg",
  "custom": 0,
  "istable": 1,
  "issingle": 0,
  "editable_grid": 1,
  "track_changes": 1,
  "field_order": [
    "supplier",
    "submission",
    "preliminary_result",
    "technical_score",
