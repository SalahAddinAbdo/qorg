    {
      "fieldname": "preliminary_result",
      "label": "Preliminary Result",
      "fieldtype": "Select",
      "options": "Pending\nResponsive\nConditionally Responsive\nNon-Responsive\nDisqualified"
    },
    {
      "fieldname": "technical_score",
      "label": "Technical Score",
      "fieldtype": "Float"
    },
    {
      "fieldname": "technical_weighted",
      "label": "Technical Weighted",
      "fieldtype": "Float"
    },
    {
      "fieldname": "evaluated_price",
      "label": "Evaluated Price",
      "fieldtype": "Currency"
    },
    {
      "fieldname": "financial_score",
      "label": "Financial Score",
      "fieldtype": "Float"
    },
    {
      "fieldname": "financial_weighted",
      "label": "Financial Weighted",
      "fieldtype": "Float"
    },
    {
      "fieldname": "total_score",
      "label": "Total Score",
      "fieldtype": "Float"
    },
    {
      "fieldname": "rank",
      "label": "Rank",
      "fieldtype": "Int"
    },
    {
      "fieldname": "recommendation",
      "label": "Recommendation",
