{
  "doctype": "DocType",
  "name": "Q Org Design Preset",
  "module": "QOrg",
  "custom": 0,
  "autoname": "field:preset_title",
  "title_field": "preset_title",
  "track_changes": 1,
  "field_order": [
    "identity_section",
    "preset_title",
    "enabled",
    "is_system_preset",
    "identity_column",
    "description",
    "appearance_section",
    "theme_mode",
    "density",
    "primary_color",
    "accent_color",
    "appearance_column",
    "content_width",
    "navigation_style",
    "surface_style",
    "tokens_json",
    "managed_version"
  ],
  "fields": [
    {
      "fieldname": "identity_section",
      "fieldtype": "Section Break",
      "label": "Preset"
    },
    {
      "fieldname": "preset_title",
      "fieldtype": "Data",
      "label": "Title",
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1"
    },
    {
      "fieldname": "is_system_preset",
      "fieldtype": "Check",
      "label": "System Preset",
      "read_only": 1
    },
    {
      "fieldname": "identity_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "description",
      "fieldtype": "Small Text",
      "label": "Description"
    },
    {
      "fieldname": "appearance_section",
      "fieldtype": "Section Break",
      "label": "Appearance"
    },
    {
      "fieldname": "theme_mode",
      "fieldtype": "Select",
      "label": "Theme Mode",
      "options": "Follow System\nLight\nDark",
      "default": "Follow System"
    },
    {
      "fieldname": "density",
      "fieldtype": "Select",
      "label": "Density",
      "options": "Comfortable\nCompact",
      "default": "Comfortable"
    },
    {
      "fieldname": "primary_color",
      "fieldtype": "Color",
      "label": "Primary Color",
      "default": "#137690"
    },
    {
      "fieldname": "accent_color",
      "fieldtype": "Color",
      "label": "Accent Color",
      "default": "#CBAE66"
    },
    {
      "fieldname": "appearance_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "content_width",
      "fieldtype": "Select",
      "label": "Content Width",
      "options": "Standard\nWide",
      "default": "Wide"
    },
    {
      "fieldname": "navigation_style",
      "fieldtype": "Select",
      "label": "Navigation Style",
      "options": "Standard\nIntegrated",
      "default": "Integrated"
    },
    {
      "fieldname": "surface_style",
      "fieldtype": "Select",
      "label": "Surface Style",
      "options": "Flat\nSoft\nElevated",
      "default": "Soft"
    },
    {
      "fieldname": "tokens_json",
      "fieldtype": "Code",
      "label": "Advanced Semantic Tokens",
      "options": "JSON",
      "description": "Optional advanced tokens. Leave blank for system presets."
    },
    {
      "fieldname": "managed_version",
      "fieldtype": "Data",
      "label": "Managed Version",
      "read_only": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    }
  ]
}
