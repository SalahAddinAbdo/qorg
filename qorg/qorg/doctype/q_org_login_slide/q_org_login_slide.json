{
  "doctype": "DocType",
  "name": "Q Org Login Slide",
  "module": "QOrg",
  "custom": 0,
  "istable": 1,
  "editable_grid": 1,
  "field_order": [
    "enabled",
    "image",
    "mobile_image",
    "column_break_1",
    "title",
    "subtitle",
    "section_break_1",
    "image_position",
    "overlay_opacity",
    "text_alignment"
  ],
  "fields": [
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "image",
      "fieldtype": "Attach Image",
      "label": "Image",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 3
    },
    {
      "fieldname": "mobile_image",
      "fieldtype": "Attach Image",
      "label": "Mobile Image"
    },
    {
      "fieldname": "column_break_1",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "title",
      "fieldtype": "Data",
      "label": "Title",
      "translate": 1,
      "in_list_view": 1,
      "columns": 3
    },
    {
      "fieldname": "subtitle",
      "fieldtype": "Small Text",
      "label": "Subtitle",
      "translate": 1
    },
    {
      "fieldname": "section_break_1",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "image_position",
      "fieldtype": "Select",
      "label": "Image Position",
      "options": "Center\nTop\nBottom\nLeft\nRight",
      "default": "Center"
    },
    {
      "fieldname": "overlay_opacity",
      "fieldtype": "Percent",
      "label": "Overlay Opacity",
      "default": "38"
    },
    {
      "fieldname": "text_alignment",
      "fieldtype": "Select",
      "label": "Text Alignment",
      "options": "Start\nCenter\nEnd",
      "default": "Center"
    }
  ],
  "permissions": [],
  "sort_field": "idx",
  "sort_order": "ASC",
  "track_changes": 0
}
