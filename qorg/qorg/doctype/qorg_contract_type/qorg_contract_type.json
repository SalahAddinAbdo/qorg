    {
      "fieldname": "party_section",
      "label": "Party Policy",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "party_model",
      "label": "Party Model",
      "fieldtype": "Select",
      "options": "Standard Party\nExtended Party\nEither Standard or Extended\nMultiple Parties\nNo Counterparty",
      "default": "Standard Party",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "require_primary_party",
      "label": "Require Primary Party",
      "fieldtype": "Check",
      "default": "1",
      "depends_on": "eval:doc.party_model!='No Counterparty'"
    },
    {
      "fieldname": "party_column",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_party_type",
      "label": "Default Standard Party Type",
      "fieldtype": "Link",
      "options": "DocType",
      "depends_on": "eval:['Standard Party','Either Standard or Extended'].includes(doc.party_model)"
    },
    {
      "fieldname": "default_extended_party_doctype",
      "label": "Default Extended Party DocType",
      "fieldtype": "Link",
      "options": "DocType",
      "depends_on": "eval:['Extended Party','Either Standard or Extended','Multiple Parties'].includes(doc.party_model)"
    },
    {
      "fieldname": "allow_multiple_parties",
      "label": "Allow Multiple Parties",
      "fieldtype": "Check",
      "default": "0",
      "depends_on": "eval:doc.party_model=='Multiple Parties'",
      "read_only_depends_on": "eval:doc.party_model=='Multiple Parties'"
    },
    {
      "fieldname": "allowed_party_types",
      "label": "Legacy Allowed Party Types",
      "fieldtype": "Small Text",
      "hidden": 1,
      "read_only": 1
