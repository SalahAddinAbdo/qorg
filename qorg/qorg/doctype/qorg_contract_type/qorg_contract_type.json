      "fieldname": "identity_section",
      "label": "Identity and Classification",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "type_name",
      "label": "Contract Type",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "category",
      "label": "Category",
      "fieldtype": "Select",
      "options": "Employment\nProcurement\nSupply\nService\nWorks\nConsultancy\nVolunteer\nInternship\nPartnership\nCustomer\nFramework Agreement\nFunding / Grant\nLease\nMemorandum of Understanding\nOther",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "is_active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "identity_column",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "contract_nature",
      "label": "Contract Nature",
      "fieldtype": "Select",
      "options": "Legal Contract\nAgreement\nMemorandum\nEngagement\nFramework",
      "default": "Legal Contract",
      "reqd": 1
    },
    {
      "fieldname": "type_code",
      "label": "Internal Contract Type Code",
      "fieldtype": "Data",
      "unique": 1
