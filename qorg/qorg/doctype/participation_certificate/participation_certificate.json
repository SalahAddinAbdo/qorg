{
  "doctype": "DocType",
  "name": "Participation Certificate",
  "module": "QOrg",
  "custom": 0,
  "track_changes": 1,
  "autoname": "naming_series:",
  "field_order": [
    "naming_series",
    "engagement",
    "external_person",
    "participation_type",
    "issue_date",
    "hours_completed",
    "role_title",
    "start_date",
    "end_date",
    "status",
    "certificate_file",
    "revoked_on",
    "revoked_by",
    "revocation_reason"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "options": "PCERT-.YYYY.-.#####",
      "default": "PCERT-.YYYY.-.#####",
      "reqd": 1
    },
    {
      "fieldname": "engagement",
      "label": "Participation Engagement",
      "fieldtype": "Link",
      "options": "Participation Engagement",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "external_person",
      "label": "External Person",
      "fieldtype": "Link",
      "options": "External Person",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "participation_type",
      "label": "Participation Type",
      "fieldtype": "Select",
      "options": "Volunteer\nIntern",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "issue_date",
      "label": "Issue Date",
      "fieldtype": "Date",
      "reqd": 1,
      "default": "Today",
      "in_list_view": 1
    },
    {
      "fieldname": "hours_completed",
      "label": "Hours Completed",
      "fieldtype": "Float",
      "read_only": 1
    },
    {
      "fieldname": "role_title",
      "label": "Role / Assignment Title",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "start_date",
      "label": "Start Date",
      "fieldtype": "Date",
      "read_only": 1
    },
    {
      "fieldname": "end_date",
      "label": "End Date",
      "fieldtype": "Date",
      "read_only": 1
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nIssued\nRevoked",
      "default": "Draft",
      "reqd": 1,
      "in_list_view": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "certificate_file",
      "label": "Certificate File",
      "fieldtype": "Attach",
      "read_only": 1
    },
    {
      "fieldname": "revoked_on",
      "label": "Revoked On",
      "fieldtype": "Datetime",
      "read_only": 1
    },
    {
      "fieldname": "revoked_by",
      "label": "Revoked By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "revocation_reason",
      "label": "Revocation Reason",
      "fieldtype": "Small Text",
      "depends_on": "eval:doc.status==\"Revoked\""
    }
  ],
  "permissions": [
    {
      "role": "Volunteer Coordinator",
      "read": 1,
      "write": 1,
      "create": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Volunteer Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "print": 1,
      "email": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "title_field": "external_person",
  "search_fields": "external_person,engagement,status"
}
