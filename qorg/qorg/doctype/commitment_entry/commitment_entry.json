{
  "doctype": "DocType",
  "name": "Commitment Entry",
  "module": "QOrg",
  "custom": 0,
  "istable": 1,
  "editable_grid": 1,
  "field_order": [
    "stage",
    "posting_date",
    "reference_doctype",
    "reference_name",
    "amount",
    "direction",
    "remarks",
    "page_break"
  ],
  "fields": [
    {
      "fieldname": "stage",
      "label": "Stage",
      "fieldtype": "Select",
      "options": "Planned\nRequested\nReserved\nOrdered\nContracted\nReceived\nAccepted\nInvoiced\nPaid\nReleased\nCancelled",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "posting_date",
      "label": "Posting Date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "reference_doctype",
      "label": "Reference Doctype",
      "fieldtype": "Link",
      "options": "DocType",
      "reqd": 1,
      "in_list_view": 0
    },
    {
      "fieldname": "reference_name",
      "label": "Reference Name",
      "fieldtype": "Dynamic Link",
      "options": "reference_doctype",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "amount",
      "label": "Amount",
      "fieldtype": "Currency",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "direction",
      "label": "Direction",
      "fieldtype": "Select",
      "options": "Increase\nDecrease",
      "reqd": 1,
      "in_list_view": 1,
      "columns": 1
    },
    {
      "fieldname": "remarks",
      "label": "Remarks",
      "fieldtype": "Small Text",
      "in_list_view": 0
    },
    {
      "fieldname": "page_break",
      "label": "Page Break After This Row",
      "fieldtype": "Check",
      "default": "0",
      "allow_on_submit": 1,
      "print_hide": 1,
      "in_list_view": 0,
      "description": "Starts a new printed page after this row in managed print formats."
    }
  ],
  "permissions": []
}
