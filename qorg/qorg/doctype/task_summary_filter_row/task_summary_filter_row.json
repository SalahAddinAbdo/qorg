{
  "doctype": "DocType",
  "name": "Task Summary Filter Row",
  "module": "QFap Adds",
  "istable": 1,
  "editable_grid": 1,
  "field_order": [
    "filter_type",
    "status",
    "priority",
    "task_type",
    "project",
    "enabled"
  ],
  "fields": [
