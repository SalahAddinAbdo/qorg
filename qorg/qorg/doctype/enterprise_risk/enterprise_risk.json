      "read_only": 1
    },
    {
      "fieldname": "last_reviewed_by",
      "label": "Last Reviewed By",
      "fieldtype": "Link",
      "options": "User",
      "read_only": 1
    },
    {
      "fieldname": "review_cb",
      "label": "",
