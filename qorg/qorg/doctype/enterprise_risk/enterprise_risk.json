{
  "doctype": "DocType",
  "name": "Enterprise Risk",
  "module": "QOrg",
  "custom": 0,
  "istable": 0,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "naming_series",
      "label": "Series",
      "fieldtype": "Select",
      "options": "ERISK-.YYYY.-.#####",
      "default": "ERISK-.YYYY.-.#####",
      "reqd": 1
    },
    {
      "fieldname": "overview_tab",
      "label": "Risk",
      "fieldtype": "Tab Break"
    },
    {
      "fieldname": "identity_section",
      "label": "Risk Identity",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "risk_title",
      "label": "Risk Title",
      "fieldtype": "Data",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "company",
      "label": "Company",
      "fieldtype": "Link",
      "options": "Company",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "risk_category",
      "label": "Risk Category",
      "fieldtype": "Select",
      "options": "Strategic\nOperational\nFinancial\nCompliance\nFraud\nSafeguarding\nSecurity\nData Protection\nReputation\nProgrammatic\nOther",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "risk_owner",
      "label": "Risk Owner",
      "fieldtype": "Link",
      "options": "User",
      "reqd": 1
    },
    {
      "fieldname": "identity_cb",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "status",
      "label": "Status",
      "fieldtype": "Select",
      "options": "Draft\nOpen\nTreatment In Progress\nMonitoring\nClosed\nAccepted\nEscalated",
      "default": "Draft",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "priority",
      "label": "Priority",
      "fieldtype": "Select",
      "options": "Low\nMedium\nHigh\nCritical",
      "default": "Medium"
    },
    {
      "fieldname": "project_risk",
      "label": "Project Risk",
      "fieldtype": "Link",
      "options": "Project Risk"
    },
    {
      "fieldname": "accountability_case",
      "label": "Accountability Case",
      "fieldtype": "Link",
      "options": "Accountability Case"
    },
    {
      "fieldname": "assurance_finding",
      "label": "Assurance Finding",
      "fieldtype": "Link",
      "options": "Assurance Finding"
    },
    {
      "fieldname": "risk_narrative_section",
      "label": "Risk Narrative",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "risk_event",
      "label": "Risk Event",
      "fieldtype": "Text Editor",
      "reqd": 1
    },
    {
      "fieldname": "causes",
      "label": "Causes",
      "fieldtype": "Text Editor",
      "reqd": 1
    },
    {
      "fieldname": "consequences",
      "label": "Consequences",
      "fieldtype": "Text Editor",
      "reqd": 1
    },
    {
      "fieldname": "existing_controls",
      "label": "Existing Controls",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "appetite_section",
