      "fieldtype": "Section Break"
    },
    {
      "fieldname": "assessments",
      "label": "Assessments",
      "fieldtype": "Table",
      "options": "Risk Assessment Entry"
    },
    {
      "fieldname": "treatment_section",
      "label": "Treatment Plan",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "treatment_actions",
      "label": "Treatment Actions",
      "fieldtype": "Table",
      "options": "Risk Treatment Action"
    },
    {
      "fieldname": "review_section",
      "label": "Review and Closure",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "next_review_date",
