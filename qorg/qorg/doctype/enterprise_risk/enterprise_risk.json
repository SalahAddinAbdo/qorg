    "consequences",
    "existing_controls",
    "appetite_section",
    "risk_appetite",
    "tolerance_threshold",
    "escalation_required",
    "assessment_tab",
    "assessment_section",
    "assessments",
    "treatment_section",
    "treatment_actions",
    "review_section",
    "next_review_date",
    "last_reviewed_on",
    "last_reviewed_by",
    "review_cb",
    "closure_evidence",
    "closure_notes"
