      "fieldtype": "Section Break"
    },
    {
      "fieldname": "risk_appetite",
      "label": "Risk Appetite",
      "fieldtype": "Select",
      "options": "Averse\nMinimal\nCautious\nOpen\nSeeking",
      "reqd": 1
    },
    {
      "fieldname": "tolerance_threshold",
      "label": "Tolerance Threshold",
      "fieldtype": "Int"
    },
    {
      "fieldname": "escalation_required",
      "label": "Escalation Required",
      "fieldtype": "Check",
      "read_only": 1
