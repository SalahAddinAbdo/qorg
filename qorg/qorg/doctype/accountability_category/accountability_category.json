{
  "doctype": "DocType",
  "name": "Accountability Category",
  "module": "QOrg",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "category_name",
      "label": "Category Name",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "classification_section",
      "label": "Classification",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "domain",
      "label": "Domain",
