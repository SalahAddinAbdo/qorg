    },
    {
      "fieldname": "condition_at_issue",
      "label": "Issue Condition",
      "fieldtype": "Select",
      "options": "Good\nAcceptable\nDamaged",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "condition_at_return",
      "label": "Return Condition",
      "fieldtype": "Select",
      "options": "Good\nAcceptable\nDamaged\nMissing",
      "in_list_view": 1,
      "columns": 2
    },
    {
      "fieldname": "notes_section",
      "label": "Notes",
      "fieldtype": "Section Break"
