{
  "doctype": "DocType",
  "name": "Accountability Channel",
  "module": "QOrg",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "channel_name",
      "label": "Channel Name",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "channel_kind",
      "label": "Channel Kind",
      "fieldtype": "Select",
      "options": "Hotline\nCall Center\nSMS\nWhatsApp\nEmail\nWebsite\nHelp Desk\nCommunity Meeting\nSuggestion Box\nField Visit\nPartner Referral\nStaff Referral\nIn Person\nLetter\nOther",
      "reqd": 1
    },
    {
      "fieldname": "enabled",
      "label": "Enabled",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "allows_anonymous",
      "label": "Allows Anonymous",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "requires_contact",
      "label": "Requires Contact Details",
      "fieldtype": "Check"
    },
    {
      "fieldname": "instructions",
      "label": "Instructions",
      "fieldtype": "Small Text"
    }
  ],
  "field_order": [
    "channel_name",
    "channel_kind",
    "enabled",
    "allows_anonymous",
    "requires_contact",
    "instructions"
  ],
  "track_changes": 1,
  "actions": [],
  "links": [],
  "states": [],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "Accountability Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "Accountability Officer",
      "read": 1,
      "report": 1,
      "select": 1
    }
  ],
  "autoname": "field:channel_name",
  "naming_rule": "Expression",
  "title_field": "channel_name",
  "show_title_field_in_link": 1
}
