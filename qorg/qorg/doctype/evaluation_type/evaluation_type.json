{
  "doctype": "DocType",
  "name": "Evaluation Type",
  "module": "QOrg",
  "custom": 0,
  "track_changes": 1,
  "field_order": [
    "overview_section",
    "type_name",
    "type_code",
    "frequency",
    "qorg_overview_section_0_column",
    "applies_to",
    "active",
    "rating_scale",
    "qorg_overview_section_0_column_2",
    "completion_policy",
    "min_completion",
    "source_score_max",
    "qorg_overview_section_more_1",
    "due_days",
    "confidentiality",
    "content_section",
    "self_required",
    "goals_included",
    "competencies_included",
    "development_required",
    "content_column",
    "allow_promotion",
    "allow_contract_renewal",
    "allow_probation_decision",
    "instructions_section",
    "instructions",
    "sources_section",
    "sources"
  ],
  "fields": [
    {
      "fieldname": "overview_section",
      "label": "Evaluation Policy",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "type_name",
      "label": "Evaluation Type",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "type_code",
      "label": "Code",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "frequency",
      "label": "Frequency",
      "fieldtype": "Select",
      "options": "One Time\nProbation\nQuarterly\nSemi-Annual\nAnnual\nSpecial",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "qorg_overview_section_0_column",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "applies_to",
      "label": "Applies To",
      "fieldtype": "Select",
      "options": "Employee\nProbation Employee\nManager\nLeadership\nProject Staff\nConsultant\nVolunteer / Intern",
      "default": "Employee",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "active",
      "label": "Active",
      "fieldtype": "Check",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "rating_scale",
      "label": "Rating Scale",
      "fieldtype": "Link",
      "options": "Rating Scale",
      "reqd": 1
    },
    {
      "fieldname": "qorg_overview_section_0_column_2",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "completion_policy",
      "label": "Completion Policy",
      "fieldtype": "Select",
      "options": "Strict Completion\nCompleted Weight\nReallocate Weight",
      "default": "Strict Completion",
      "reqd": 1
    },
    {
      "fieldname": "min_completion",
      "label": "Minimum Completion (%)",
      "fieldtype": "Percent",
      "default": "100",
      "reqd": 1
    },
    {
      "fieldname": "source_score_max",
      "label": "Source Score Maximum",
      "fieldtype": "Float",
      "default": "5",
      "reqd": 1,
      "description": "Maximum raw score used by Goals, Self and Feedback before conversion to a percentage."
    },
    {
      "fieldname": "qorg_overview_section_more_1",
      "label": "Additional Details",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "due_days",
      "label": "Assignment Due Days",
      "fieldtype": "Int",
      "default": "14",
      "reqd": 1
    },
    {
      "fieldname": "confidentiality",
      "label": "Confidentiality Policy",
      "fieldtype": "Select",
      "options": "Named Feedback\nAnonymous Sources\nAggregated Sources Only",
      "default": "Named Feedback",
      "reqd": 1
    },
    {
      "fieldname": "content_section",
      "label": "Evaluation Content",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "self_required",
      "label": "Self-Appraisal Required",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "goals_included",
      "label": "Goals Included",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "competencies_included",
      "label": "Competencies Included",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "development_required",
      "label": "Development Plan Required",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "content_column",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "allow_promotion",
      "label": "Promotion Recommendation Allowed",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "allow_contract_renewal",
      "label": "Contract Renewal Recommendation Allowed",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "allow_probation_decision",
      "label": "Probation Decision Allowed",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "instructions_section",
      "label": "Instructions",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "instructions",
      "label": "Instructions",
      "fieldtype": "Text Editor"
    },
    {
      "fieldname": "sources_section",
      "label": "Evaluation Sources",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "sources",
      "label": "Sources",
      "fieldtype": "Table",
      "options": "Evaluation Source",
      "reqd": 1
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "HR Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    },
    {
      "role": "HR User",
      "read": 1,
      "write": 1,
      "create": 1,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    }
  ],
  "autoname": "field:type_name",
  "title_field": "type_name"
}
