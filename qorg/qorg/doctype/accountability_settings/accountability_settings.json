{
  "doctype": "DocType",
  "name": "Accountability Settings",
  "module": "QOrg",
  "custom": 0,
  "istable": 0,
  "issingle": 1,
  "engine": "InnoDB",
  "fields": [
    {
      "fieldname": "accountability_tab",
      "label": "Accountability",
      "fieldtype": "Tab Break"
    },
    {
      "fieldname": "sla_section",
      "label": "Default Service Levels",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "default_acknowledgement_days",
      "label": "Default Acknowledgement Days",
      "fieldtype": "Int",
      "default": "2",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "default_triage_days",
      "label": "Default Triage Days",
      "fieldtype": "Int",
      "default": "2",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "complex_priority_threshold",
      "label": "Complex Case Priority Threshold",
      "fieldtype": "Select",
      "options": "High\nCritical",
      "default": "High",
      "reqd": 1
    },
    {
      "fieldname": "sla_cb",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_response_days",
      "label": "Default Response Days",
      "fieldtype": "Int",
      "default": "15",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "complex_response_days",
      "label": "Complex Response Days",
      "fieldtype": "Int",
      "default": "30",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "update_frequency_days",
      "label": "Open Case Update Frequency Days",
      "fieldtype": "Int",
      "default": "7",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "privacy_section",
      "label": "Privacy and Access",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "allow_anonymous_cases",
      "label": "Allow Anonymous Cases",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "force_private_attachments",
      "label": "Force Private Attachments",
      "fieldtype": "Check",
      "default": "1",
      "description": "When enabled, governed record attachments are forced to Private. Disabling requires an explicit security review."
    },
    {
      "fieldname": "hide_sensitive_details_in_notifications",
      "label": "Hide Sensitive Details in Notifications",
      "fieldtype": "Check",
      "default": "1",
      "description": "When enabled, sensitive case subjects and details are excluded from outbound notifications."
    },
    {
      "fieldname": "privacy_cb",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "default_accountability_role",
      "label": "Default Accountability Role",
      "fieldtype": "Link",
      "options": "Role",
      "default": "Accountability Officer"
    },
    {
      "fieldname": "default_accountability_manager_role",
      "label": "Default Accountability Manager Role",
      "fieldtype": "Link",
      "options": "Role",
      "default": "Accountability Manager"
    },
    {
      "fieldname": "critical_escalation_role",
      "label": "Critical Escalation Role",
      "fieldtype": "Link",
      "options": "Role"
    },
    {
      "fieldname": "migration_section",
      "label": "Legacy Migration",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "enable_legacy_procurement_complaint_migration",
      "label": "Enable Legacy Procurement Complaint Migration",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "lock_legacy_procurement_complaints",
      "label": "Lock Legacy Procurement Complaints",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "migration_version",
      "label": "Migration Version",
      "fieldtype": "Data",
      "default": "v1.0",
      "read_only": 1
    },
    {
      "fieldname": "portal_tab",
      "label": "Portal and Security",
      "fieldtype": "Tab Break"
    },
    {
      "fieldname": "portal_security_section",
      "label": "Public Intake and Tracking",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "enable_public_intake",
      "label": "Enable Public Intake",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "enable_public_tracking",
      "label": "Enable Public Tracking",
      "fieldtype": "Check",
      "default": "0"
    },
    {
      "fieldname": "require_captcha",
      "label": "Require CAPTCHA",
      "fieldtype": "Check",
      "default": "1"
    },
    {
      "fieldname": "captcha_verifier_method",
      "label": "CAPTCHA Verifier Method",
      "fieldtype": "Data",
      "description": "Dotted Python method that accepts a token and returns true only after successful verification."
    },
    {
      "fieldname": "portal_security_cb",
      "label": "",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "intake_rate_limit_per_hour",
      "label": "Intake Requests per IP per Hour",
      "fieldtype": "Int",
      "default": "5",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "tracking_rate_limit_per_hour",
      "label": "Tracking Requests per IP per Hour",
      "fieldtype": "Int",
      "default": "20",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "tracking_token_validity_days",
      "label": "Tracking Token Validity Days",
      "fieldtype": "Int",
      "default": "365",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "retention_section",
      "label": "Retention and Privacy",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "closed_case_retention_days",
      "label": "Closed Case Retention Days",
      "fieldtype": "Int",
      "default": "2555",
      "non_negative": 1,
      "description": "Policy reference only. Automatic case deletion is intentionally disabled; records are retained for audit unless a separately approved purge process is implemented."
    },
    {
      "fieldname": "anonymize_contact_after_days",
      "label": "Anonymize Contact After Days",
      "fieldtype": "Int",
      "default": "365",
      "non_negative": 1,
      "reqd": 1
    },
    {
      "fieldname": "disable_tracking_after_closure_days",
      "label": "Disable Tracking After Closure Days",
      "fieldtype": "Int",
      "default": "90",
      "non_negative": 1,
      "reqd": 1
    }
  ],
  "field_order": [
    "accountability_tab",
