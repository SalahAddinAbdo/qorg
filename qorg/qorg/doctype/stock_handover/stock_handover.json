{
  "doctype": "DocType",
  "name": "Stock Handover",
  "module": "QOrg",
  "custom": 0,
  "istable": 0,
  "issingle": 0,
  "editable_grid": 0,
  "track_changes": 1,
  "field_order": [
    "naming_series",
    "workflow_state",
