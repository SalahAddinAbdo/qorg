{
  "doctype": "DocType",
  "name": "Q Org Design System Settings",
  "module": "QOrg",
  "custom": 0,
  "issingle": 1,
  "track_changes": 1,
  "field_order": [
    "baseline_section",
    "enabled",
    "active_preset",
    "language_section",
    "show_language_action",
    "quick_create_section",
    "quick_create_items"
  ],
  "fields": [
    {
      "fieldname": "baseline_section",
      "fieldtype": "Section Break",
      "label": "Frappe Baseline"
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enable Custom Theme",
      "default": "0",
      "read_only": 1,
      "description": "Disabled during the Frappe baseline reset."
    },
    {
      "fieldname": "active_preset",
      "fieldtype": "Link",
      "label": "Active Preset",
      "options": "Q Org Design Preset",
      "default": "Frappe Standard",
      "read_only": 1
    },
    {
      "fieldname": "language_section",
      "fieldtype": "Section Break",
      "label": "Language"
    },
    {
      "fieldname": "show_language_action",
      "fieldtype": "Check",
      "label": "Show Language Action",
      "default": "1"
    },
    {
      "fieldname": "quick_create_section",
      "fieldtype": "Section Break",
      "label": "Quick Create Configuration"
    },
    {
      "fieldname": "quick_create_items",
      "fieldtype": "Table",
      "label": "Quick Create Items",
      "options": "Q Org Quick Create Item",
      "description": "Configuration is preserved for the next design phase. No custom New button is loaded during baseline reset."
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 0,
      "report": 1,
      "export": 1,
      "print": 1,
      "email": 1,
      "share": 1
    }
  ]
}
