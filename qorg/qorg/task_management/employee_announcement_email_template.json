{
  "doctype": "Email Template",
  "name": "New Employee Announcement - Bilingual",
  "subject": "🎉 Welcoming {{ employee_name or name }} to Our Team",
  "use_html": 1,
  "response_html": "<!-- QFAP DEFAULT: NEW EMPLOYEE ANNOUNCEMENT - BILINGUAL v1 -->\n<div style=\"margin:0;padding:0;background-color:#eef2f5;font-family:Arial,Tahoma,sans-serif;color:#263238;line-height:1.7;\">\n  <div style=\"max-width:760px;margin:0 auto;padding:24px 10px;\">\n    <div style=\"background-color:#ffffff;border:1px solid #d9e1e5;border-radius:12px;overflow:hidden;box-shadow:0 3px 12px rgba(20,55,70,0.08);\">\n      <div style=\"background-color:#176b87;padding:28px 24px;text-align:center;\">\n        <div style=\"width:72px;height:72px;margin:0 auto 12px;border:3px solid #a8d3df;border-radius:50%;background-color:#fff;color:#176b87;font-size:34px;line-height:72px;\">👋</div>\n        <div style=\"font-size:23px;font-weight:bold;color:#fff;direction:rtl;\">🎉 نرحب بانضمام {{ arabic_colleague }} جديد إلى فريقنا</div>\n        <div style=\"margin-top:5px;font-size:16px;color:#e6f3f7;direction:ltr;\">✨ Welcoming a New Colleague to Our Team</div>\n        <div style=\"display:inline-block;margin-top:14px;padding:6px 18px;background-color:#fff;color:#176b87;border-radius:20px;font-size:15px;font-weight:bold;\">{{ employee_name or name }}</div>\n      </div>\n      <div style=\"padding:28px;\">\n        <div style=\"direction:rtl;text-align:right;font-size:14px;\">\n          <p style=\"margin:0 0 12px;\">الزملاء والزميلات الأعزاء،</p>\n          <p style=\"margin:0 0 14px;\">يسرنا أن نرحب بانضمام <strong style=\"color:#176b87;\">{{ arabic_colleague }} {{ employee_name or name }}</strong> إلى فريق العمل في <strong>{{ company or \"\" }}</strong>{% if designation %} بصفة <strong>{{ designation }}</strong>{% endif %}{% if department %} ضمن <strong>{{ department }}</strong>{% endif %}.</p>\n          <p style=\"margin:0 0 14px;\">نتمنى {{ arabic_support_object }} بداية موفقة ومسيرة مهنية ناجحة، وندعو الجميع إلى الترحيب {{ arabic_welcome_object }} وتقديم الدعم والتعاون اللازمين خلال فترة التعريف والاندماج في بيئة العمل.</p>\n        </div>\n        <div style=\"height:1px;margin:22px 0;background-color:#e1e7ea;\"></div>\n        <div style=\"direction:ltr;text-align:left;font-size:14px;\">\n          <p style=\"margin:0 0 12px;\">Dear Colleagues,</p>\n          <p style=\"margin:0 0 14px;\">We are pleased to welcome <strong style=\"color:#176b87;\">{{ employee_name or name }}</strong> to the team at <strong>{{ company or \"\" }}</strong>{% if designation %} as <strong>{{ designation }}</strong>{% endif %}{% if department %} in <strong>{{ department }}</strong>{% endif %}.</p>\n          <p style=\"margin:0 0 14px;\">We wish our new colleague a successful start and a rewarding professional journey. We encourage everyone to extend a warm welcome and provide the necessary support and cooperation during the orientation and integration period.</p>\n        </div>\n        <div style=\"margin-top:25px;padding:8px 12px;background-color:#176b87;color:#fff;font-size:16px;font-weight:bold;text-align:center;\">👤 بيانات {{ arabic_colleague }} الجديد | New Colleague Information</div>\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"width:100%;border-collapse:collapse;border:1px solid #dfe3e8;font-size:14px;\">\n          <tr><td style=\"width:35%;padding:10px 12px;background:#f6f8fa;border:1px solid #dfe3e8;font-weight:bold;direction:rtl;text-align:right;\">الاسم<br><span style=\"font-weight:normal;font-size:12px;\">Name</span></td><td style=\"padding:10px 12px;border:1px solid #dfe3e8;\">{{ employee_name or name }}</td></tr>\n          {% if employee_number %}<tr><td style=\"padding:10px 12px;background:#f6f8fa;border:1px solid #dfe3e8;font-weight:bold;direction:rtl;text-align:right;\">الرقم الوظيفي<br><span style=\"font-weight:normal;font-size:12px;\">Employee Number</span></td><td style=\"padding:10px 12px;border:1px solid #dfe3e8;direction:ltr;text-align:left;\">{{ employee_number }}</td></tr>{% endif %}\n          <tr><td style=\"padding:10px 12px;background:#f6f8fa;border:1px solid #dfe3e8;font-weight:bold;direction:rtl;text-align:right;\">المسمى الوظيفي<br><span style=\"font-weight:normal;font-size:12px;\">Designation</span></td><td style=\"padding:10px 12px;border:1px solid #dfe3e8;\">{{ designation or \"\" }}</td></tr>\n          <tr><td style=\"padding:10px 12px;background:#f6f8fa;border:1px solid #dfe3e8;font-weight:bold;direction:rtl;text-align:right;\">الإدارة / القسم<br><span style=\"font-weight:normal;font-size:12px;\">Department</span></td><td style=\"padding:10px 12px;border:1px solid #dfe3e8;\">{{ department or \"\" }}</td></tr>\n          {% if branch %}<tr><td style=\"padding:10px 12px;background:#f6f8fa;border:1px solid #dfe3e8;font-weight:bold;direction:rtl;text-align:right;\">الفرع / موقع العمل<br><span style=\"font-weight:normal;font-size:12px;\">Branch / Work Location</span></td><td style=\"padding:10px 12px;border:1px solid #dfe3e8;\">{{ branch }}</td></tr>{% endif %}\n          {% if employment_type %}<tr><td style=\"padding:10px 12px;background:#f6f8fa;border:1px solid #dfe3e8;font-weight:bold;direction:rtl;text-align:right;\">نوع التوظيف<br><span style=\"font-weight:normal;font-size:12px;\">Employment Type</span></td><td style=\"padding:10px 12px;border:1px solid #dfe3e8;\">{{ employment_type }}</td></tr>{% endif %}\n          <tr><td style=\"padding:10px 12px;background:#f6f8fa;border:1px solid #dfe3e8;font-weight:bold;direction:rtl;text-align:right;\">تاريخ الالتحاق<br><span style=\"font-weight:normal;font-size:12px;\">Date of Joining</span></td><td style=\"padding:10px 12px;border:1px solid #dfe3e8;direction:ltr;text-align:left;\">{% if date_of_joining %}{{ frappe.format(date_of_joining, {\"fieldtype\":\"Date\"}) }}{% endif %}</td></tr>\n        </table>\n        {% if employee_bio %}<div style=\"margin-top:22px;padding:15px 17px;border:1px solid #dfe3e8;border-radius:6px;background:#f8fafb;\"><div style=\"margin-bottom:8px;font-weight:bold;color:#176b87;text-align:center;\">💡 نبذة تعريفية | Brief Introduction</div><div style=\"unicode-bidi:plaintext;\">{{ employee_bio | safe }}</div></div>{% endif %}\n        {% if additional_message %}<div style=\"margin-top:22px;padding:15px 17px;border:1px solid #bdd7ea;border-left:4px solid #176b87;border-radius:6px;background:#eef6fb;\"><div style=\"margin-bottom:8px;font-weight:bold;color:#176b87;text-align:center;\">📣 رسالة إضافية | Additional Message</div><div style=\"white-space:pre-line;unicode-bidi:plaintext;\">{{ additional_message }}</div></div>{% endif %}\n        <div style=\"margin-top:22px;padding:14px 16px;border:1px solid #b7dec5;border-radius:6px;background:#eef9f2;text-align:center;\"><div style=\"direction:rtl;color:#236b3d;font-weight:bold;\">👋 أهلًا وسهلًا {{ arabic_welcome_object }} ضمن فريقنا</div><div style=\"direction:ltr;margin-top:4px;color:#236b3d;font-weight:bold;\">Welcome aboard! We are glad to have you with us.</div></div>\n        <div style=\"margin-top:20px;padding:15px;background:#f7fafb;border:1px solid #dfe3e8;text-align:center;\"><div style=\"direction:rtl;\">نرحب بانضمام {{ arabic_new_colleague }} إلى فريقنا، ونتمنى {{ arabic_success_object }} النجاح والتوفيق في {{ arabic_possessive_journey }} المهنية معنا.</div><div style=\"direction:ltr;margin-top:5px;\">Please join us in welcoming our new colleague and wishing them every success in their professional journey with us.</div></div>\n        <div style=\"margin-top:18px;padding:11px 13px;background:#fff9e6;border:1px solid #ead9a6;border-radius:6px;color:#66561e;text-align:center;font-size:12px;\"><div style=\"direction:rtl;\">💬 يمكنكم الترحيب {{ arabic_welcome_object }} باستخدام خيار الرد للجميع.</div><div style=\"direction:ltr;margin-top:3px;\">You may welcome our new colleague by using Reply All.</div></div>\n        <div style=\"margin-top:24px;text-align:center;\"><strong style=\"color:#176b87;font-size:15px;\">{{ company or \"\" }}</strong><div style=\"margin-top:3px;color:#697780;font-size:12px;\">الموارد البشرية | Human Resources</div></div>\n      </div>\n      <div style=\"padding:12px 18px;background:#f6f8fa;border-top:1px solid #dfe3e8;text-align:center;color:#7a858c;font-size:11px;\"><div style=\"direction:rtl;\">إشعار داخلي موجه إلى فريق العمل</div><div style=\"direction:ltr;margin-top:2px;\">Internal announcement for team members</div></div>\n    </div>\n  </div>\n</div>"
}
